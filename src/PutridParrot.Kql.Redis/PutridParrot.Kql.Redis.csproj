<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PutridParrot.Kql\PutridParrot.Kql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Redis sources for PutridParrot.Kql: query Redis strings, hashes, JSON documents, streams and RediSearch indexes (with filters pushed into FT.SEARCH) with KQL.</Description>
    <PackageTags>$(PackageTags);redis;redisearch</PackageTags>
  </PropertyGroup>

</Project>
