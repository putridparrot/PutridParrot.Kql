<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PutridParrot.Kql\PutridParrot.Kql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Entity Framework Core support for PutridParrot.Kql: translates more KQL functions to SQL and runs joins in the database when both sides share a provider.</Description>
    <PackageTags>$(PackageTags);efcore;entityframeworkcore;sql</PackageTags>
  </PropertyGroup>

</Project>
